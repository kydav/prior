rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Per-user lookup usage counter.
    match /users/{userId}/usage/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Saved lookups: the user's own list of places and notes.
    match /users/{userId}/saved/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 2000
        && (
          // A saved water right: its number; where it is when known.
          (request.resource.data.get('kind', '') == 'right'
            && request.resource.data.rightNumber is string
            && request.resource.data.rightNumber.size() <= 40
            && request.resource.data.get('lat', 0) is number
            && request.resource.data.get('lng', 0) is number)
          // A saved place (docs from before rights have no kind).
          || (request.resource.data.get('kind', 'place') == 'place'
            && request.resource.data.lat is number
            && request.resource.data.lng is number)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
